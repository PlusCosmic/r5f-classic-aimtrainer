"mod"
{
	"author"		"pluscosmic"
	"name"			"Aim Trainer (Classic)"
	"id"			"Cosmic.AimTrainer"
	"description"	"Port of the R5Reloaded Flowstate Aim Trainer (drills, live stats, results) to R5 Flowstate."
	"version"		"0.1.0"
	"realm"			"both"

	"ScriptWraps"
	{
		"AimTrainer_SV_FinishChallenge"
		{
			"Function"	"cosmic_aimtrainer__AimTrainer_SV_FinishChallenge"
			"VM"		"SERVER"
		}
		"AimTrainer_CL_PushChallengeFlagToUI"
		{
			"Function"	"cosmic_aimtrainer__AimTrainer_CL_PushChallengeFlagToUI"
			"VM"		"CLIENT"
		}
	}

	// Client-side settings, remembered between sessions. The client pushes them
	// to the server whenever they change and on every level load.
	"ConVars"
	{
		"cosmic_aimtrainer_duration"
		{
			"helpText"	"Aim trainer: challenge duration in seconds"
			"flags"		"ARCHIVE"
			"Values" { "default" "60" "min" "10" "max" "600" }
		}
		"cosmic_aimtrainer_infinite"
		{
			"helpText"	"Aim trainer: ignore the duration and run until you exit"
			"flags"		"ARCHIVE"
			"Values" { "default" "0" "min" "0" "max" "1" }
		}
		"cosmic_aimtrainer_shield"
		{
			"helpText"	"Aim trainer: dummy shield level 0-4"
			"flags"		"ARCHIVE"
			"Values" { "default" "0" "min" "0" "max" "4" }
		}
		"cosmic_aimtrainer_speed"
		{
			"helpText"	"Aim trainer: dummy strafe speed 0-4 (0 = static)"
			"flags"		"ARCHIVE"
			"Values" { "default" "2" "min" "0" "max" "4" }
		}
		"cosmic_aimtrainer_distance"
		{
			"helpText"	"Aim trainer: dummy spawn distance multiplier 1-20"
			"flags"		"ARCHIVE"
			"Values" { "default" "1" "min" "1" "max" "20" }
		}
		"cosmic_aimtrainer_health"
		{
			"helpText"	"Aim trainer: dummy health 1-100"
			"flags"		"ARCHIVE"
			"Values" { "default" "100" "min" "1" "max" "100" }
		}
		"cosmic_aimtrainer_color"
		{
			"helpText"	"Aim trainer: dummy skin 0-4, 5 = random"
			"flags"		"ARCHIVE"
			"Values" { "default" "5" "min" "0" "max" "5" }
		}
		"cosmic_aimtrainer_immortal"
		{
			"helpText"	"Aim trainer: targets heal after every hit"
			"flags"		"ARCHIVE"
			"Values" { "default" "0" "min" "0" "max" "1" }
		}
		"cosmic_aimtrainer_reloadhit"
		{
			"helpText"	"Aim trainer: refill ammo on every hit"
			"flags"		"ARCHIVE"
			"Values" { "default" "1" "min" "0" "max" "1" }
		}
		"cosmic_aimtrainer_custommenus"
		{
			"helpText"	"Aim trainer: 0 = use the Dev Menu pages instead of the custom menus"
			"flags"		"ARCHIVE"
			"Values" { "default" "1" "min" "0" "max" "1" }
		}
		"cosmic_aimtrainer_reloadkill"
		{
			"helpText"	"Aim trainer: refill ammo on every kill"
			"flags"		"ARCHIVE"
			"Values" { "default" "0" "min" "0" "max" "1" }
		}

		// Saved loadouts, presets and playlists (ui_cat_storage.gnut). String
		// values; no min/max. "-" = empty slot.
		"cosmic_aimtrainer_lo0p"
