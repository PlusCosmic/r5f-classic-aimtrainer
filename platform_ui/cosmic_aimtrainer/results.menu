		// The original used ui/footer_button.rpak; generic_button.rpak is the
		// button RUI verified to load in the S21 client.
		MainMenuButton
		{
			ControlName				RuiButton
			rui						"ui/generic_button.rpak"
			wide					180
			tall					36
			xpos					%5.5
			ypos					%-0.5
			zpos					1
			visible					1
			enabled					1
			scriptID				0
			sound_focus				"UI_Menu_Focus"
			cursorVelocityModifier	0.7

			ruiArgs
			{
				buttonText			"MAIN MENU"
			}

			pin_to_sibling			ChallengeResultsFrame
			pin_corner_to_sibling	BOTTOM
			pin_to_sibling_corner	BOTTOM
		}

